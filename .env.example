# Copy this file to .env and fill in your credentials

# Reddit API credentials (required for sentiment collection)
# Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=f1_prediction_bot/1.0

# UI cockpit configuration
UI_DENSITY_DEFAULT=dense
UI_ENABLE_LIVE_WIDGETS=false
UI_TASK_POLL_SECONDS=5
UI_MAX_VISIBLE_BLOCKS=6
